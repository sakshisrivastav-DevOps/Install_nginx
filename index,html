<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hello Sakshi</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    :root{
      --bg:#0b0f17;
      --card:#0f1625cc;
      --stroke:#1f2a40;
      --text:#e7eefc;
      --muted:#a9b4cc;
      --brand:#ff7a18;
      --brand2:#ffb703;
      --shadow: 0 18px 60px rgba(0,0,0,.45);
      --radius: 20px;
    }

    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:"Space Grotesk", system-ui, -apple-system, Segoe UI, Roboto, Arial;
      color:var(--text);
      background:
        radial-gradient(900px 500px at 12% 10%, rgba(255,122,24,.25), transparent 55%),
        radial-gradient(700px 420px at 85% 12%, rgba(255,183,3,.18), transparent 55%),
        radial-gradient(800px 520px at 60% 90%, rgba(68,108,255,.12), transparent 60%),
        linear-gradient(180deg, #070b12, var(--bg));
      min-height:100vh;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:28px;
    }

    .wrap{
      width:min(980px, 100%);
      display:grid;
      gap:18px;
    }

    .topbar{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:14px;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:10px;
      color:var(--muted);
      letter-spacing:.2px;
      font-size:14px;
    }

    .dot{
      width:10px;height:10px;border-radius:999px;
      background:linear-gradient(135deg, var(--brand), var(--brand2));
      box-shadow: 0 0 0 6px rgba(255,122,24,.12);
    }

    .pill{
      padding:8px 12px;
      border:1px solid var(--stroke);
      background:rgba(255,255,255,.03);
      border-radius:999px;
      color:var(--muted);
      font-size:13px;
    }

    .hero{
      border:1px solid var(--stroke);
      background:linear-gradient(180deg, rgba(255,255,255,.03), rgba(255,255,255,.01));
      border-radius:var(--radius);
      box-shadow:var(--shadow);
      overflow:hidden;
      position:relative;
    }

    .hero-inner{
      position:relative;
      padding:34px 28px;
      display:grid;
      gap:14px;
    }

    h1{
      margin:0;
      font-size:44px;
    }

    h1 .accent{
      background: linear-gradient(90deg, var(--brand), var(--brand2));
      -webkit-background-clip:text;
      color:transparent;
    }

    h2{
      margin:0;
      font-weight:600;
      color:var(--muted);
      font-size:18px;
    }
  </style>
</head>

<body>
  <main class="wrap">
    <div class="topbar">
      <div class="brand">
        <span class="dot"></span>
        <span>Welcome Sakshi</span>
      </div>
      <div class="pill">Dark + Orange Zest ✨</div>
    </div>

    <section class="hero">
      <div class="hero-inner">
        <h1>Hello <span class="accent">Sakshi</span> 👋</h1>
        <h2>
          padhiye padhiye mann lagakar
        </h2>
      </div>
    </section>

    <footer>
      Built with ❤️ • Dark theme • Orange zest
    </footer>
  </main>
</body>
</html>
``
